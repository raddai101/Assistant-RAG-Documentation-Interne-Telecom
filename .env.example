# ============================================================
# POSTGRESQL
# ============================================================

POSTGRES_DB=tekis_db
POSTGRES_USER=tekis_user
POSTGRES_PASSWORD=tekis_pass


# ============================================================
# FLASK
# ============================================================

FLASK_ENV=production

SECRET_KEY=change-this-secret-key
JWT_SECRET_KEY=change-this-jwt-secret-key

JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

ADMIN_ROLE_NAMES=admin


# ============================================================
# OLLAMA
# ============================================================

OLLAMA_BASE_URL=http://ollama:11434

OLLAMA_LLM_MODEL=qwen3:14b
OLLAMA_EMBEDDING_MODEL=bge-m3

OLLAMA_TEMPERATURE=0.15
OLLAMA_TOP_P=0.9
OLLAMA_TOP_K=40


# ============================================================
# CHROMADB
# ============================================================

CHROMA_PERSIST_DIR=/app/data/chroma

CHROMA_COLLECTION_NAME=tekis_enterprise_kb

RETRIEVAL_TOP_K=10

RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

HYBRID_CANDIDATE_K=50

CONFIDENCE_THRESHOLD=0.5


# ============================================================
# NEO4J
# ============================================================

NEO4J_URI=bolt://neo4j:7687

NEO4J_USER=neo4j

NEO4J_PASSWORD=change-me


# ============================================================
# FICHIERS
# ============================================================

MAX_UPLOAD_SIZE_MB=50

INGESTION_STORAGE_DIR=/app/data/documents

QUARANTINE_DIR=/app/data/quarantine